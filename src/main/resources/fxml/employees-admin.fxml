<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.carrental.gui.EmployeesAdminController"
      stylesheets="@app.css"
      styleClass="screen-root">
    <children>

        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="topbar-card">
            <children>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Pracownicy" styleClass="section-title"/>
                        <Label text="Zarządzaj pracownikami wypożyczalni" styleClass="section-subtitle"/>
                    </children>
                </VBox>
                <Button fx:id="addEmployeeButton" text="+ Dodaj pracownika" styleClass="primary-button"/>
                <Button fx:id="backButton" text="← Wróć" styleClass="secondary-button"/>
            </children>
            <padding><Insets top="16.0" right="18.0" bottom="16.0" left="18.0"/></padding>
        </HBox>

        <HBox spacing="12.0">
            <children>
                <TextField fx:id="searchField" promptText="Szukaj po imieniu, nazwisku lub emailu..."
                           HBox.hgrow="ALWAYS" styleClass="app-input"/>
                <ComboBox fx:id="roleFilter" promptText="Rola"/>
            </children>
            <padding><Insets left="14.0" right="14.0"/></padding>
        </HBox>

        <VBox spacing="10.0" styleClass="table-wrapper" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="employeesTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId"        text="ID"        prefWidth="60.0"/>
                        <TableColumn fx:id="colFirstName" text="Imię"      prefWidth="130.0"/>
                        <TableColumn fx:id="colLastName"  text="Nazwisko"  prefWidth="130.0"/>
                        <TableColumn fx:id="colEmail"     text="Email"     prefWidth="200.0"/>
                        <TableColumn fx:id="colPhone"     text="Telefon"   prefWidth="130.0"/>
                        <TableColumn fx:id="colRole"      text="Rola"      prefWidth="110.0"/>
                        <TableColumn fx:id="colActions"   text="Akcje"     prefWidth="160.0"/>
                    </columns>
                    <placeholder><Label text="Brak pracowników" styleClass="placeholder-label"/></placeholder>
                </TableView>
            </children>
            <padding><Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/></padding>
        </VBox>

    </children>
    <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
</VBox>