<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.carrental.gui.MyReservationsController"
      stylesheets="@app.css"
      styleClass="screen-root">
    <children>

        <!-- TOP BAR -->
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="topbar-card">
            <children>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Moje rezerwacje" styleClass="section-title"/>
                        <Label text="Historia i aktywne rezerwacje" styleClass="section-subtitle"/>
                    </children>
                </VBox>
                <Button fx:id="backButton" text="← Wróć" styleClass="secondary-button"/>
            </children>
            <padding><Insets top="16.0" right="18.0" bottom="16.0" left="18.0"/></padding>
        </HBox>

        <!-- STATS ROW -->
        <HBox spacing="12.0">
            <children>
                <VBox styleClass="info-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4.0">
                    <children>
                        <Label text="AKTYWNE" styleClass="section-subtitle"/>
                        <Label fx:id="activeCount" text="0" styleClass="section-title"/>
                    </children>
                    <padding><Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/></padding>
                </VBox>
                <VBox styleClass="info-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4.0">
                    <children>
                        <Label text="ZAKOŃCZONE" styleClass="section-subtitle"/>
                        <Label fx:id="completedCount" text="0" styleClass="section-title"/>
                    </children>
                    <padding><Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/></padding>
                </VBox>
                <VBox styleClass="info-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4.0">
                    <children>
                        <Label text="ANULOWANE" styleClass="section-subtitle"/>
                        <Label fx:id="cancelledCount" text="0" styleClass="section-title"/>
                    </children>
                    <padding><Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/></padding>
                </VBox>
            </children>
            <padding><Insets left="14.0" right="14.0"/></padding>
        </HBox>

        <!-- FILTERS -->
        <HBox spacing="12.0">
            <children>
                <TextField fx:id="searchField" promptText="Szukaj po pojeździe..."
                           HBox.hgrow="ALWAYS" styleClass="app-input"/>
                <ComboBox fx:id="statusFilter" promptText="Wszystkie"
                          prefWidth="150.0" styleClass="combo-box"/>
            </children>
            <padding><Insets left="14.0" right="14.0"/></padding>
        </HBox>

        <!-- TABLE -->
        <VBox spacing="10.0" styleClass="table-wrapper" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="reservationsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId"      text="ID"      prefWidth="55.0"/>
                        <TableColumn fx:id="colVehicle" text="Pojazd"  prefWidth="200.0"/>
                        <TableColumn fx:id="colStart"   text="Od"      prefWidth="120.0"/>
                        <TableColumn fx:id="colEnd"     text="Do"      prefWidth="120.0"/>
                        <TableColumn fx:id="colCost"    text="Koszt"   prefWidth="100.0"/>
                        <TableColumn fx:id="colStatus"  text="Status"  prefWidth="130.0"/>
                        <TableColumn fx:id="colActions" text="Akcje"   prefWidth="160.0"/>
                    </columns>
                    <placeholder><Label text="Brak rezerwacji" styleClass="placeholder-label"/></placeholder>
                </TableView>
            </children>
            <padding><Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/></padding>
        </VBox>

    </children>
    <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
</VBox>