<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="420.0" prefWidth="620.0" styleClass="screen-root" stylesheets="@app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carrental.gui.LoginController">

   <children>
      <StackPane prefHeight="420.0" prefWidth="620.0" styleClass="login-background">
         <children>
            <ImageView fitHeight="240.0" fitWidth="240.0" opacity="0.18" preserveRatio="true">
               <image>
                  <Image url="@../static/carrental_icon.png" />
               </image>
            </ImageView>
         </children>
      </StackPane>

      <StackPane styleClass="overlay-dark" />

      <VBox alignment="CENTER" maxWidth="420.0" prefWidth="420.0" spacing="16.0" styleClass="glass-card">
         <children>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <ImageView fitHeight="44.0" fitWidth="44.0" preserveRatio="true">
                     <image>
                        <Image url="@../static/carrental_icon.png" />
                     </image>
                  </ImageView>
                  <Label styleClass="page-title" text="CarRental" />
               </children>
            </HBox>

            <Label styleClass="section-title" text="Wynajem samochodów" />
            <Label styleClass="section-subtitle" text="Zaloguj się, aby przejść do listy pojazdów" />

            <Label styleClass="brand-chip" text="Panel użytkownika" />

            <VBox spacing="6.0">
               <children>
                  <Label styleClass="field-label" text="Email" />
                  <TextField fx:id="emailField" promptText="admin@car.pl" styleClass="app-input" />
               </children>
            </VBox>

            <VBox spacing="6.0">
               <children>
                  <Label styleClass="field-label" text="Hasło" />
                  <PasswordField fx:id="passwordField" promptText="Wpisz hasło" styleClass="app-input" />
               </children>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" text="" wrapText="true" />

            <Button onAction="#handleLogin" prefHeight="40.0" prefWidth="260.0" styleClass="primary-button" text="Zaloguj się" />
            <Button onAction="#openRegister" prefHeight="40.0" prefWidth="260.0" styleClass="primary-button" text="Rejestracja" />
         </children>

         <padding>
            <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
         </padding>
      </VBox>
   </children>
</StackPane>
