<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.carrental.gui.RegisterController"
      stylesheets="@app.css"
      styleClass="screen-root">
  <children>
    <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="topbar-card">
      <children>
        <ImageView fitHeight="40.0" fitWidth="40.0" preserveRatio="true">
          <image><Image url="@../static/carrental_icon.png" /></image>
        </ImageView>
        <VBox spacing="2.0">
          <children>
            <Label text="Rejestracja" styleClass="section-title" />
            <Label text="Utwórz nowe konto użytkownika" styleClass="section-subtitle" />
          </children>
        </VBox>
      </children>
      <padding><Insets top="16.0" right="18.0" bottom="16.0" left="18.0" /></padding>
    </HBox>

    <VBox spacing="16.0" styleClass="form-wrapper">
      <children>
        <HBox spacing="14.0">
          <children>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
              <children>
                <Label text="Imię" styleClass="field-label" />
                <TextField fx:id="firstNameField" promptText="Imię" styleClass="app-input" />
              </children>
            </VBox>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
              <children>
                <Label text="Nazwisko" styleClass="field-label" />
                <TextField fx:id="lastNameField" promptText="Nazwisko" styleClass="app-input" />
              </children>
            </VBox>
          </children>
        </HBox>

        <HBox spacing="14.0">
          <children>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
              <children>
                <Label text="Email" styleClass="field-label" />
                <TextField fx:id="emailField" promptText="Podaj email" styleClass="app-input" />
              </children>
            </VBox>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
              <children>
                <Label text="Telefon" styleClass="field-label" />
                <TextField fx:id="phoneField" promptText="np. 600123456" styleClass="app-input" />
              </children>
            </VBox>
          </children>
        </HBox>

        <HBox spacing="14.0">
          <children>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
              <children>
                <Label text="Hasło" styleClass="field-label" />
                <PasswordField fx:id="passwordField" promptText="Hasło" styleClass="app-input" />
              </children>
            </VBox>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
              <children>
                <Label text="Powtórz hasło" styleClass="field-label" />
                <PasswordField fx:id="confirmPasswordField" promptText="Powtórz hasło" styleClass="app-input" />
              </children>
            </VBox>
          </children>
        </HBox>

        <Label fx:id="errorLabel" text="" style="-fx-text-fill: #cc0000;" />

        <HBox spacing="12.0">
          <children>
            <Button fx:id="registerButton" text="Zarejestruj" styleClass="primary-button" />
            <Button fx:id="backButton" text="Wróć do logowania" styleClass="secondary-button"
                    onAction="#goToLogin"

            />

          </children>
        </HBox>
      </children>
      <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0" /></padding>
    </VBox>
  </children>
  <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0" /></padding>
</VBox>