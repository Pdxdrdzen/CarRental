<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.carrental.gui.UserDashboardController"
      stylesheets="@app.css"
      styleClass="screen-root">
    <children>

        <!-- TOP BAR -->
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="topbar-card">
            <children>
                <ImageView fitHeight="42.0" fitWidth="42.0" preserveRatio="true">
                    <image><Image url="@../static/carrental_icon.png"/></image>
                </ImageView>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="welcomeLabel" text="Witaj!" styleClass="section-title"/>
                        <Label text="Panel użytkownika CarRental" styleClass="section-subtitle"/>
                    </children>
                </VBox>
                <Button fx:id="logoutButton" text="Wyloguj" styleClass="primary-button"/>
            </children>
            <padding><Insets top="16.0" right="18.0" bottom="16.0" left="18.0"/></padding>
        </HBox>

        <!-- STATS ROW -->
        <HBox spacing="14.0">
            <children>
                <VBox styleClass="info-card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="6.0">
                    <children>
                        <Label text="AKTYWNE REZERWACJE" styleClass="section-subtitle"/>
                        <Label fx:id="statActive" text="—" styleClass="page-title"/>
                    </children>
                    <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
                </VBox>
                <VBox styleClass="info-card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="6.0">
                    <children>
                        <Label text="ZAKOŃCZONE REZERWACJE" styleClass="section-subtitle"/>
                        <Label fx:id="statCompleted" text="—" styleClass="page-title"/>
                    </children>
                    <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
                </VBox>
                <VBox styleClass="info-card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="6.0">
                    <children>
                        <Label text="DOSTĘPNE POJAZDY" styleClass="section-subtitle"/>
                        <Label fx:id="statVehicles" text="—" styleClass="page-title"/>
                    </children>
                    <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
                </VBox>
            </children>
            <padding><Insets left="2.0" right="2.0"/></padding>
        </HBox>

        <!-- MAIN CONTENT -->
        <HBox spacing="14.0" VBox.vgrow="ALWAYS">
            <children>

                <!-- LEFT: nawigacja -->
                <VBox spacing="10.0" prefWidth="230.0" styleClass="form-wrapper">
                    <children>
                        <Label text="Szybka nawigacja" styleClass="subsection-title"/>

                        <Button fx:id="btnVehicles" text="🚗  Lista pojazdów"
                                styleClass="secondary-button" maxWidth="1.7976931348623157E308"
                                onAction="#goToVehicles"/>

                        <Button fx:id="btnNewReservation" text="📋  Nowa rezerwacja"
                                styleClass="primary-button" maxWidth="1.7976931348623157E308"
                                onAction="#goToNewReservation"/>

                        <Button fx:id="btnMyReservations" text="📁  Moje rezerwacje"
                                styleClass="secondary-button" maxWidth="1.7976931348623157E308"
                                onAction="#goToMyReservations"/>

                        <Label text="Konto" styleClass="subsection-title"
                               VBox.margin="$top-spacer"/>

                        <Label fx:id="accountEmail" text="" styleClass="helper-label"/>
                        <Label fx:id="accountRole"  text="" styleClass="helper-label"/>
                    </children>
                    <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
                </VBox>

                <!-- RIGHT: ostatnie rezerwacje -->
                <VBox spacing="12.0" styleClass="table-wrapper"
                      HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Ostatnie rezerwacje" styleClass="subsection-title"
                                       HBox.hgrow="ALWAYS"/>
                                <Button text="Zobacz wszystkie" styleClass="primary-button"
                                        onAction="#goToMyReservations"/>
                            </children>
                        </HBox>

                        <TableView fx:id="recentTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colVehicle" text="Pojazd"  prefWidth="200.0"/>
                                <TableColumn fx:id="colStart"   text="Od"      prefWidth="120.0"/>
                                <TableColumn fx:id="colEnd"     text="Do"      prefWidth="120.0"/>
                                <TableColumn fx:id="colCost"    text="Koszt"   prefWidth="100.0"/>
                                <TableColumn fx:id="colStatus"  text="Status"  prefWidth="130.0"/>
                            </columns>
                            <placeholder>
                                <Label text="Brak rezerwacji" styleClass="placeholder-label"/>
                            </placeholder>
                        </TableView>
                    </children>
                    <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
                </VBox>

            </children>
        </HBox>

    </children>
    <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
</VBox>