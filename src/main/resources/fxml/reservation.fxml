<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.carrental.gui.ReservationController"
      stylesheets="@app.css"
      styleClass="screen-root">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="topbar-card">
            <children>
                <ImageView fitHeight="40.0" fitWidth="40.0" preserveRatio="true">
                    <image><Image url="@../static/carrental_icon.png" /></image>
                </ImageView>
                <VBox spacing="2.0">
                    <children>
                        <Label text="Nowa rezerwacja" styleClass="section-title" />
                        <Label text="Uzupełnij dane wypożyczenia pojazdu" styleClass="section-subtitle" />
                    </children>
                </VBox>
            </children>
            <padding><Insets top="16.0" right="18.0" bottom="16.0" left="18.0" /></padding>
        </HBox>

        <VBox spacing="16.0" styleClass="form-wrapper">
            <children>
                <HBox spacing="14.0">
                    <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Pojazd" styleClass="field-label" />
                                <ComboBox fx:id="vehicleCombo" promptText="Wybierz pojazd" maxWidth="1.7976931348623157E308" />
                            </children>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Metoda płatności" styleClass="field-label" />
                                <ComboBox fx:id="paymentMethodCombo" promptText="Wybierz metodę" maxWidth="1.7976931348623157E308" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="14.0">
                    <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Data rozpoczęcia" styleClass="field-label" />
                                <DatePicker fx:id="startDatePicker" maxWidth="1.7976931348623157E308" />
                            </children>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Data zakończenia" styleClass="field-label" />
                                <DatePicker fx:id="endDatePicker" maxWidth="1.7976931348623157E308" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="6.0">
                    <children>
                        <Label text="Uwagi" styleClass="field-label" />
                        <TextArea fx:id="notesArea" promptText="Dodatkowe informacje..." prefRowCount="3" styleClass="app-input" />
                    </children>
                </VBox>

                <Label fx:id="totalCostLabel" text="" styleClass="section-subtitle" />
                <Label fx:id="errorLabel" text="" style="-fx-text-fill: #cc0000;" />

                <HBox spacing="12.0">
                    <children>
                        <Button fx:id="saveButton" text="Zapisz rezerwację" styleClass="primary-button" />
                        <Button fx:id="cancelButton" text="Anuluj" styleClass="secondary-button" />
                    </children>
                </HBox>
            </children>
            <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0" /></padding>
        </VBox>
    </children>
    <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0" /></padding>
</VBox>