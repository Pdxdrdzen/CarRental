<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="720.0" prefWidth="1180.0" styleClass="wall-bg" stylesheets="@app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <HBox spacing="24.0" styleClass="surface-wrap" AnchorPane.bottomAnchor="26.0" AnchorPane.leftAnchor="26.0" AnchorPane.rightAnchor="26.0" AnchorPane.topAnchor="26.0">
      <padding>
        <Insets bottom="26.0" left="26.0" right="26.0" top="26.0" />
      </padding>
      <children>
        <VBox prefWidth="430.0" spacing="16.0" styleClass="side-card">
          <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
          </padding>
          <children>
            <Label styleClass="badge-label" text="Wypożyczalnia samochodów" />
            <Label styleClass="page-title neon-pink" text="Logowanie" textFill="WHITE" />
            <Label styleClass="body-text" text="Zaloguj sie do wybranego panelu, aby testować funkcje użytkownika, zarządzać elementami lub przejsc do panelu administratora" wrapText="true" />
            <VBox spacing="12.0">
              <children>
                <Label styleClass="list-chip" text="Panel użytkownika" />
                <Label styleClass="list-chip" text="Panel administratora" />
                <Label prefHeight="35.0" prefWidth="188.0" style="-fx-background-radius: 20;" styleClass="list-chip" text="Panel pracownika" />
              </children>
            </VBox>
            <Region prefHeight="10.0" />
          </children>
        </VBox>
        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
          <children>
            <VBox alignment="CENTER" maxWidth="400.0" spacing="16.0" styleClass="main-card">
              <padding>
                <Insets bottom="34.0" left="34.0" right="34.0" top="34.0" />
              </padding>
              <children>
                <Label styleClass="section-title neon-cyan" text="Zaloguj się" textAlignment="CENTER" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font></Label>
                <Label styleClass="subtitle" text="Wpisz dane i wybierz odpowiedni panel." wrapText="true" />
                <VBox spacing="8.0">
                  <children>
                    <Label styleClass="field-label" text="Login lub e-mail" />
                    <TextField fx:id="loginField" prefHeight="44.0" promptText="np. admin@uczelnia.pl" styleClass="neon-input" />
                  </children>
                </VBox>
                <VBox spacing="8.0">
                  <children>
                    <Label styleClass="field-label" text="Hasło" />
                    <PasswordField fx:id="passwordField" prefHeight="44.0" promptText="Wpisz hasło" styleClass="neon-input" />
                  </children>
                </VBox>
                <Button styleClass="neon-button primary-button" text="Zaloguj" textFill="#95f7ff">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font></Button>
                <HBox spacing="6.0">
                  <children>
                    <Label styleClass="soft-text" text="Nie masz konta?" />
                    <Hyperlink fx:id="goToRegisterLink" text="Zarejestruj się" />
                  </children>
                </HBox>
              </children>
            </VBox>
          </children>
        </VBox>
      </children>
    </HBox>
  </children>
</AnchorPane>
